{
  "name": "iekaradenai-site-work",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-works.mjs && node scripts/gen-og.mjs && next build",
