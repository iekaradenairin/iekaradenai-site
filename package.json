    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.160.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "satori": "^0.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
